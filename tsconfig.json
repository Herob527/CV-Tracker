{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layout/*"],
      "@styles/*": ["./src/styles/*"],
      "@core/*": ["./src/core/*"],
      "@feature/*": ["./src/feature/*"],
      "@db/*": ["./src/db/*"]
    }
  }
}
